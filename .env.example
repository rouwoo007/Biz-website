# Google Analytics 4 Measurement ID (from analytics.google.com → Admin → Data Streams)
# Looks like G-ABC1234XYZ
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web3Forms access key for the "Get a Quote" form. Free — no account needed:
#   1. Go to https://web3forms.com
#   2. Enter fixitup@outlook.com as the destination email
#   3. They email you an access key (a UUID) — paste it below
# This key is safe to expose in the browser; it only forwards submissions to your inbox.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
